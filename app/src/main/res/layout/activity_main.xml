<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- Which counting mode is in use; hidden on the age picker -->
    <TextView
        android:id="@+id/mode_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:padding="10dp"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Age picker: only when the app is opened without a form -->
    <LinearLayout
        android:id="@+id/picker_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/picker_title"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pick_full_button"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:background="@drawable/btn_tap"
            android:text="@string/picker_under_2"
            android:textSize="32sp" />

        <Button
            android:id="@+id/pick_quick_button"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:background="@drawable/btn_tap_quick"
            android:text="@string/picker_2_and_over"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/picker_note"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Error: the form sent a mode the app doesn't know -->
    <LinearLayout
        android:id="@+id/error_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/error_title"
            android:textColor="@color/restart"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/close_button"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/btn_tap"
            android:text="@string/close"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- Counting screen -->
    <LinearLayout
        android:id="@+id/counting_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/breaths_label" />

                <TextView
                    android:id="@+id/breath_count"
                    style="@style/StatValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/seconds_left_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/seconds_left_label" />

                <TextView
                    android:id="@+id/seconds_left"
                    style="@style/StatValue" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/time_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:max="60000" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minLines="2"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <Button
            android:id="@+id/tap_button"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/btn_tap"
            android:textSize="36sp" />
    </LinearLayout>

    <!-- Result screen -->
    <LinearLayout
        android:id="@+id/result_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/result_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="120sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/breaths_per_minute"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/result_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/save_button"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:background="@drawable/btn_save"
            android:text="@string/save_result"
            android:textSize="34sp" />
    </LinearLayout>

    <Button
        android:id="@+id/restart_button"
        style="@style/BigButton"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/btn_restart"
        android:text="@string/start_over"
        android:textColor="@color/restart_text"
        android:textSize="24sp" />
</LinearLayout>
