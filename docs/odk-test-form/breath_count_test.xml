<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Breath count test</h:title><model odk:xforms-version="1.0.0"><instance><data id="breath_count_test" version="2"><pid>test-14m</pid><age/><rr_mode/><show_mode/><exam_breathing><resp_rate_grp><resp_rate/><resp_rate_method/><resp_rate_quick/><resp_rate_taps/></resp_rate_grp><b_chest_indraw/></exam_breathing><resp1_elev/><exam_breathing_2><resp_rate_2_grp><resp_rate_2/><resp_rate_2_method/><resp_rate_2_quick/><resp_rate_2_taps/></resp_rate_2_grp></exam_breathing_2><meta><instanceID/></meta></data></instance><instance id="wkl" src="jr://file-csv/wkl.csv"/><instance id="tfalse"><root><item><name>true</name><label>Yes</label></item><item><name>false</name><label>No</label></item></root></instance><bind nodeset="/data/pid" type="string" required="true()"/><bind nodeset="/data/age" type="string" calculate="pulldata('wkl', 'ccage', 'pid',  /data/pid )"/><bind nodeset="/data/rr_mode" type="string" calculate="if( /data/age  != '' and  /data/age  &gt;= 24, 'quick', 'full')"/><bind nodeset="/data/show_mode" readonly="true()" type="string"/><bind nodeset="/data/exam_breathing/resp_rate_grp/resp_rate" type="int" required="true()" constraint=". &gt; 0"/><bind nodeset="/data/exam_breathing/resp_rate_grp/resp_rate_method" type="string"/><bind nodeset="/data/exam_breathing/resp_rate_grp/resp_rate_quick" type="int"/><bind nodeset="/data/exam_breathing/resp_rate_grp/resp_rate_taps" type="string"/><bind nodeset="/data/exam_breathing/b_chest_indraw" type="string"/><bind nodeset="/data/resp1_elev" type="string" calculate="if(( /data/age  &lt; 2 and  /data/exam_breathing/resp_rate_grp/resp_rate  &gt; 60) or ( /data/age  &lt;= 12 and  /data/age  &gt;= 2 and  /data/exam_breathing/resp_rate_grp/resp_rate  &gt; 50) or ( /data/age  &gt; 12 and  /data/age  &lt; 60 and  /data/exam_breathing/resp_rate_grp/resp_rate  &gt; 40) or ( /data/age  &gt;= 60 and  /data/exam_breathing/resp_rate_grp/resp_rate  &gt; 30), 'true', 'false')"/><bind nodeset="/data/exam_breathing_2" relevant=" /data/resp1_elev  = 'true'"/><bind nodeset="/data/exam_breathing_2/resp_rate_2_grp/resp_rate_2" type="int" required="true()" constraint=". &gt; 0"/><bind nodeset="/data/exam_breathing_2/resp_rate_2_grp/resp_rate_2_method" type="string"/><bind nodeset="/data/exam_breathing_2/resp_rate_2_grp/resp_rate_2_quick" type="int"/><bind nodeset="/data/exam_breathing_2/resp_rate_2_grp/resp_rate_2_taps" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><input ref="/data/pid"><label>Patient ID (test-14m is 14 months old, test-30m is 30 months old)</label></input><input ref="/data/show_mode"><label> Age: <output value=" /data/age "/> months. Counting mode: <output value=" /data/rr_mode "/> </label></input><group appearance="field-list" ref="/data/exam_breathing"><label>Please watch the child's breathing while the child is calm.</label><group intent="org.taimaka.respirationrate.COUNT(mode= /data/rr_mode , prefix='resp_rate')" ref="/data/exam_breathing/resp_rate_grp"><label>Count breaths</label><input ref="/data/exam_breathing/resp_rate_grp/resp_rate"><label>Breaths per minute</label></input><input ref="/data/exam_breathing/resp_rate_grp/resp_rate_method"><label>Counting method</label></input><input ref="/data/exam_breathing/resp_rate_grp/resp_rate_quick" appearance="masked"><label>Quick-count estimate (validation only)</label></input><input ref="/data/exam_breathing/resp_rate_grp/resp_rate_taps" appearance="masked"><label>Tap times (ms)</label></input></group><select1 ref="/data/exam_breathing/b_chest_indraw"><label>Chest indrawing?</label><itemset nodeset="instance('tfalse')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group appearance="field-list" ref="/data/exam_breathing_2"><label>Fast breathing. Count again to confirm.</label><group intent="org.taimaka.respirationrate.COUNT(mode= /data/rr_mode , prefix='resp_rate_2')" ref="/data/exam_breathing_2/resp_rate_2_grp"><label>Count breaths again</label><input ref="/data/exam_breathing_2/resp_rate_2_grp/resp_rate_2"><label>Breaths per minute</label></input><input ref="/data/exam_breathing_2/resp_rate_2_grp/resp_rate_2_method"><label>Counting method</label></input><input ref="/data/exam_breathing_2/resp_rate_2_grp/resp_rate_2_quick" appearance="masked"><label>Quick-count estimate (validation only)</label></input><input ref="/data/exam_breathing_2/resp_rate_2_grp/resp_rate_2_taps" appearance="masked"><label>Tap times (ms)</label></input></group></group></h:body></h:html>