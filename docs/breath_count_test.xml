<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms">
  <h:head>
    <h:title>Breath count test</h:title>
    <model>
      <instance>
        <data id="breath_count_test" orx:version="1">
          <resp_rate/>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <bind nodeset="/data/resp_rate" type="int"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/resp_rate" appearance="ex:org.taimaka.respirationrate.COUNT">
      <label>Respiratory rate (breaths/min)</label>
    </input>
  </h:body>
</h:html>
